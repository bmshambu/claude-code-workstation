{
  "name": "ppt-addin-hello",
  "version": "0.0.1",
  "license": "MIT",
  "config": {
    "app_to_debug": "powerpoint",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.json",
    "stop": "office-addin-debugging stop manifest.json",
    "validate": "office-addin-manifest validate manifest.json",
    "start:xml": "office-addin-debugging start manifest.xml",
    "stop:xml": "office-addin-debugging stop manifest.xml",
    "set-port": "node set-port.js"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-manifest": "^2.0.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1",
    "protobufjs": ">=8.0.2",
    "serialize-javascript": ">=7.0.5",
    "axios": ">=1.18.0",
    "adm-zip": ">=0.6.0",
    "websocket-driver": ">=0.7.5",
    "@hono/node-server": ">=2.0.5"
  },
  "description": "Pitchcraft: PowerPoint add-in for authoring proposal templates"
}